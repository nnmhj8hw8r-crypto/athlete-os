{
  "name": "personal-athlete-os",
  "private": true,
  "version": "0.1.0",
  "description": "Personal Athlete OS — личная offline-first система подготовки спортсмена (дзюдо, самбо)",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"vite\" \"npm:dev:server\"",
    "dev:lan": "concurrently -k -n web,api -c blue,green \"vite --host\" \"npm:dev:server\"",
    "dev:web": "vite",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.ts",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^1.1.7",
    "fastify": "^5.12.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.6",
    "globals": "^16.5.0",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.12"
  }
}
